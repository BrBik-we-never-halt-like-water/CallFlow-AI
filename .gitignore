# secrets - never commit
.env
.env.*
!.env.example

# deps
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/

# runtime output
results/
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# scaffolding notes
apps/web/CLAUDE.md
apps/web/AGENTS.md

# next.js incremental build cache. Matched by name, not by path, so the next
# time a directory moves this does not silently start tracking it again.
*.tsbuildinfo

# subagent-driven-development scratch (plans, ledgers, task briefs/reports)
.superpowers/

# Deploy-side marker: the package-lock hash the VM last ran npm ci against.
apps/web/.lock-hash
