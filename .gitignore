# secrets - never commit
.env
.env.*
!.env.example

# deps
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/
# Generated by `next build`/`next dev` and stamped with whichever of the two
# ran last (`.next/types/` vs `.next/dev/types/`), so tracking it meant every
# build dirtied the working tree. On the deploy VM that blocked the next
# `git checkout -B` outright: "local changes would be overwritten". Next.js
# regenerates it on demand and the file itself says not to edit it.
next-env.d.ts

# runtime output
results/
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# scaffolding notes
apps/web/CLAUDE.md
apps/web/AGENTS.md

# next.js incremental build cache. Matched by name, not by path, so the next
# time a directory moves this does not silently start tracking it again.
*.tsbuildinfo

# subagent-driven-development scratch (plans, ledgers, task briefs/reports)
.superpowers/

# Playwright MCP session scratch (screenshots, console logs, page snapshots)
.playwright-mcp/

# Real vendor state written by scripts/telephony_check.py - never commit it.
.telephony-check/

# Local Docker stack env - generated from docker/.env.example on first run.
docker/.env

.agents
.claude