# CallFlow AI - local Docker stack. Copy to `.env` in this directory.
#
#   cd docker && cp .env.example .env && docker compose up
#
# Every value below is local-only and safe in version control. The JWT secret and
# the two keys derived from it are the ones Supabase's own self-hosting guide
# uses: identical on every machine, so the key printed in DEV_SETUP.md is the key
# you actually have. Nothing here listens outside localhost.

# --- Supabase platform -------------------------------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=55432

JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Signed with JWT_SECRET above. Regenerate with `npm run local:keys` if you
# change the secret - a mismatch makes every request 401 with no useful message.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwMDAwMDAwMDB9.6ldkvHM8WjwyHI_tKbJOgWu-VbulTx9jmeuEvNGSFkY
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.mjENke8J4x_734atFXjInx76tWeHpG_5y1KaXY_3Smg

REALTIME_SECRET_KEY_BASE=93f5ebf1daa957e689cf6f0e7860fcb42a1a74a1d7c276adf4276c20277a0cb5

SUPABASE_PORT=54321
STUDIO_PORT=54323
SUPABASE_PUBLIC_URL=http://localhost:54321

# --- CallFlow ----------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
SITE_URL=http://localhost:3000

# Encrypts provider credentials at rest and derives every SIP trunk password.
# A Fernet key - `npm run local:keys` prints a fresh one.
PROVIDER_CREDENTIALS_KEY=iOM7epGqR8xSa_c20h4glym8QMNeP5inGVw1ROwUmg8=
PHONE_HASH_PEPPER=392d6b1454e37e9d0a5cb3b0b40eff2d
CALLFLOW_INTERNAL_API_SECRET=d5d415372f56a75a5e6829ef4c9980ca0afaf391076a72228ed95af8c08e59e6

# Only numbers on this list can be dialled. Empty means the deployment default
# applies; keep a real number here only while you are testing against one.
CALLFLOW_ALLOWLIST=

# --- LiveKit (optional) ------------------------------------------------------
# Leave blank and everything except placing calls works: the API refuses to
# construct a gateway without them, and the voice worker refuses to start and
# says which are missing. Fill them in from a LiveKit Cloud project to dial.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_HOST=
LIVEKIT_AGENT_NAME=callflow-voice

# --- Auth email (GoTrue: password reset, email change, magic links) ----------
# Defaults catch everything in the mailpit container - read it at
# http://localhost:54324, nothing leaves the machine. GoTrue with an empty host
# does not error, it silently discards the mail, so leaving these blank is the
# one thing not to do.
#
# To send real mail through Resend instead:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<the same key as RESEND_API_KEY below>
#   SMTP_SENDER=noreply@your-verified-domain
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# A bare address - GoTrue rejects the `Name <addr>` form.
SMTP_SENDER=noreply@callflow-ai.local
SMTP_SENDER_NAME=CallFlow AI
MAILPIT_PORT=54324

# --- Resend (optional) -------------------------------------------------------
# Leave blank and everything except sending invitations works: the API refuses
# to send rather than pretending it did. Fill in a send-only key from
# resend.com to invite teammates. This is the local stack's own env file -
# the repo-root `.env` is read by Alembic and the npm scripts, not by compose.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Which vendor plugins the voice worker installs. Adding one is a rebuild:
# `docker compose build voice`.
VOICE_EXTRAS=sarvam,openai,silero
