# Copy to .env and fill in. NEVER commit .env.
#
# CALLE_API_KEY is the Voice API key used to place calls. Get it from your
# voice-engine provider dashboard.

CALLE_API_KEY=

# Default calling region + language for campaigns (per-campaign override allowed)
CALLE_DEFAULT_REGION=IN
CALLE_DEFAULT_LANGUAGE=en

# Safety: when true, CallFlow AI validates everything and NEVER dials.
# Keep this true until you are deliberately spending credits.
CALLFLOW_DRY_RUN=true

# Hard ceiling on real calls per process run. Guards your credit balance.
CALLFLOW_MAX_CALLS_PER_RUN=3

# Only these numbers may be dialed while the allowlist is non-empty.
# Comma-separated E.164. Set this to your own number during development.
CALLFLOW_ALLOWLIST=

# WhatsApp confirmation (optional — leave blank to skip)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
