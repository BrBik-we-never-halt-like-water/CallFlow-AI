# Copy to .env and fill in. NEVER commit .env.
#
# Calls run on LiveKit over the organisation's own Twilio/Plivo trunk. A run
# still needs a voice agent with a connected number before it can dial; without
# one, every contact is refused with that reason rather than silently skipped.

# --- Safety guards -----------------------------------------------------------
# Hard ceiling on real calls per run. Guards your credit balance.
CALLFLOW_MAX_CALLS_PER_RUN=3

# How many contacts in one run may be dialling at once. Starts conservative
# rather than guessing a number a carrier might reject under load.
CALLFLOW_MAX_CONCURRENT_CALLS=5

# Only these numbers may be dialed while the allowlist is non-empty.
# Comma-separated E.164. Set this to your own number during development.
CALLFLOW_ALLOWLIST=

# Calls allowed per caller per window, and the shared daily ceiling.
CALLFLOW_RATE_LIMIT_CALLS=5
CALLFLOW_RATE_LIMIT_WINDOW=3600
CALLFLOW_DAILY_BUDGET=20

# Shared secret that lifts the rate limiter for your own testing (not the
# allowlist or ceiling). Send it as X-CallFlow-Owner-Key.
CALLFLOW_OWNER_KEY=

# Extra browser origins allowed to call this API, comma-separated (deployed
# frontends). localhost:3000 always works without this.
CALLFLOW_CORS_ORIGINS=

# "text" (human-readable, default) or "json" (one object per line, for a log
# aggregator).
CALLFLOW_LOG_FORMAT=text

# This API's own publicly-reachable base URL, no trailing slash (e.g.
# https://api.example.com). The voice runtime POSTs each finished call's
# transcript back to it, so a deployment that dials must set this.
CALLFLOW_PUBLIC_API_URL=

# --- LiveKit: the media/SIP substrate ----------------------------------------
# CallFlow's own LiveKit Cloud project, not an organisation's credential - every
# org's calls run through it, over their own carrier trunks. Deploy against the
# ap-south (Mumbai) region for India-originating traffic. Empty ⇒ the gateway
# refuses to construct, so a misconfigured deployment is caught before it can
# half-create a trunk rather than at the first API call.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The registered name of the voice-runtime worker. The API dispatches this name
# into a room just before the call connects, and the worker registers under it -
# if the two disagree, the call is answered by nobody and the contact hears
# silence. Both processes read this one variable, so keep it that way.
LIVEKIT_AGENT_NAME=callflow-voice

# The LiveKit project's SIP host (e.g. abc123.sip.livekit.cloud) - what every
# carrier is told to send inbound calls to. A property of the project rather
# than of any trunk, which is why it is configuration rather than something the
# provisioning workflow discovers. Copy it from the project's SIP settings.
LIVEKIT_SIP_HOST=

# Shared secret the voice runtime presents on /internal/v1/* when it reports a
# finished call. That worker has no Supabase session, so this is the entire
# trust boundary - anyone holding it can write a transcript against any run.
# Generate a real random value (e.g. `openssl rand -hex 32`). Empty ⇒ the
# endpoint refuses every request, so calls never resolve past IN_FLIGHT.
CALLFLOW_INTERNAL_API_SECRET=

# --- OpenRouter: the metered LLM marketplace ---------------------------------
# CallFlow's *management* key, which mints one metered key per organisation.
# Not an org's own credential - it is the key that issues theirs - so it lives
# here and never in Settings → Integrations. Empty ⇒ no organisation key can be
# issued, and provisioning says so rather than failing at the first LLM call.
OPENROUTER_MANAGEMENT_KEY=

# Default spend ceiling in USD for a newly issued organisation key. 0 means
# unlimited, which is a real choice: an unmetered key on a per-token
# marketplace is how one runaway campaign becomes CallFlow's bill.
OPENROUTER_DEFAULT_LIMIT_USD=25

# --- Supabase: identity, tenancy, and persistence -----------------------------
# From your Supabase project settings.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Reachable only through app/database/privileged.py - never a
# request handler. Treat this like a root database password.
SUPABASE_SECRET_KEY=

# Asymmetric signing: tokens verify against this JWKS URL, so the API holds no
# shared secret. SUPABASE_JWT_SECRET is the legacy HS256 fallback - only needed
# if your project still issues HS256 tokens.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# The DIRECT connection string from Supabase - Settings > Database, port 5432.
# NOT the transaction pooler on 6543: asyncpg prepares every statement and
# pgbouncer's transaction mode does not support that, and every request runs
# `SET LOCAL ROLE authenticated` so RLS applies, which needs predictable session
# state. See SUPABASE_SETUP.md section 4.
#
# Percent-encode special characters in the password - a literal `@` is read as
# the host delimiter and fails with a confusing connection error.
# `BrBik@0192837465` must be written `BrBik%400192837465`.
#
# Both the API (asyncpg) and Alembic read this one variable; alembic/env.py
# rewrites the scheme to psycopg itself, because migrations are synchronous DDL.
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Pepper for the suppression list's phone hash. Generate once with
# `python -c "import secrets; print(secrets.token_hex(32))"` and never change
# it after real suppression data exists - changing it orphans every row.
PHONE_HASH_PEPPER=

# --- Org-owned provider credentials (Twilio/Plivo) ---------------------------
# Symmetric key encrypting Settings → Integrations credentials at rest. A
# Fernet key: generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Same sensitivity class as SUPABASE_SECRET_KEY - losing it makes every stored
# credential unreadable; changing it does the same.
PROVIDER_CREDENTIALS_KEY=

# --- Transactional email (team invitations only - password reset goes through
# Supabase Auth's own mailer, configured separately in the dashboard; see
# SUPABASE_SETUP.md §3) ---------------------------------------------------------
# RESEND_FROM_EMAIL's domain must be verified in the Resend dashboard (Domains
# tab, with real DNS records) before any invitation can send - a placeholder
# domain like the one below will get every send rejected with 403. See
# SUPABASE_SETUP.md §3 and ISSUES.md #51.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CallFlow AI <noreply@callflow-ai.brbik.com>

# Where the web app is served - used to build links that go out in email.
SITE_URL=http://localhost:3000

# --- WhatsApp confirmation (optional - leave blank to skip) ------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
