# CallFlow AI - frontend environment.
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local

# Where the browser reaches the calling API.
#   local dev:  http://127.0.0.1:8000
#   deployed:   https://your-api-host.example.com
# Must be a hostname a browser can resolve - an internal service address will be
# rejected at runtime and fall back to the public URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Absolute public URL of this site. Used for canonical links and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public: safe for the browser, RLS still applies) --------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…
