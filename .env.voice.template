# Voice Runtime Environment (.env for VM2)
#
# This file goes on the VOICE VM only (VM2).
# Location: <VOICE_APP_DIR>/.env
#
# CRITICAL: This VM must NEVER have database or provider credentials.
# If DATABASE_URL, DIRECT_URL, PROVIDER_CREDENTIALS_KEY, or
# SUPABASE_SERVICE_ROLE_KEY appear here, bootstrap-voice.sh will refuse to start.
#
# See: DEPLOYMENT.md §3b

# ============================================================================
# LiveKit Connection (must match API VM byte-for-byte)
# ============================================================================

# Project URL from LiveKit Cloud (H4)
LIVEKIT_URL=wss://<PROJECT_ID>.livekit.cloud

# API credentials from LiveKit Cloud (H4)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name - must match API VM exactly or dispatches go unanswered
LIVEKIT_AGENT_NAME=callflow-voice

# ============================================================================
# API Communication
# ============================================================================

# The API's PUBLIC URL (NOT localhost - this is a different machine)
# Worker POSTs completed transcripts here
CALLFLOW_PUBLIC_API_URL=https://dev.calllflow.com

# Shared secret for /internal/ endpoints - must match API VM byte-for-byte
# Generate with: openssl rand -hex 32
CALLFLOW_INTERNAL_API_SECRET=

# ============================================================================
# Optional
# ============================================================================

# Environment indicator (set by CI/CD, don't set manually)
# CALLFLOW_ENV=dev
